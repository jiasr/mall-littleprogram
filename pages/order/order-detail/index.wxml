<t-pull-down-refresh id="t-pull-down-refresh" bindrefresh="onPullDownRefresh_" t-class-indicator="t-class-indicator">
  <!-- 页面内容 -->
  <view class="order-detail">
    <view class="header">
      <!-- 订单状态入口 -->
      <view class="order-status-bar" bindtap="onShowOrderStatus">
        <view class="order-status-bar__left">
          <text class="order-status-bar__label" style="color:{{_order.statusColor}}">{{_order.statusDesc || '订单状态'}}</text>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#bbbbbb" />
      </view>
      <!-- 物流 -->
      <view class="order-logistics" wx:if="{{logisticsNodes[0]}}" bindtap="onDeliveryClick">
        <t-icon name="deliver" size="40rpx" class="logistics-icon" prefix="wr" />
        <view class="logistics-content">
          <view>{{logisticsNodes[0].desc}}</view>
          <view class="logistics-time">{{logisticsNodes[0].date}}</view>
        </view>
        <t-icon class="logistics-back" name="arrow_forward" size="36rpx" prefix="wr" />
      </view>
    </view>
    <!-- 配送地址：独立区域 -->
    <view class="address-block">
      <view class="order-logistics">
        <t-icon name="location" size="40rpx" class="logistics-icon" prefix="wr" />
        <view class="logistics-content">
          <view>{{order.consigneeName + ' '}}{{order.consigneeMobile}}</view>
          <view class="logistics-time">{{order.consigneeAddress}}</view>
        </view>
        <view wx:if="{{false}}" class="edit-text" bindtap="onEditAddressTap"> 修改 </view>
      </view>
    </view>
    <!-- 店铺及商品：每个 SKU 一行，图左文右 -->
    <order-card order="{{_order}}" use-top-right-slot wr-class="goods-card-block">
      <view class="goods-block">
        <view
          class="single-goods"
          wx:for="{{_order.goodsList}}"
          wx:key="id"
          bindtap="onGoodsCardTap"
          data-index="{{index}}"
        >
          <view class="single-goods__img-wrap">
            <t-image
              class="single-goods__img"
              t-class="single-goods__img"
              src="{{item.thumb}}"
              mode="aspectFill"
              width="120rpx"
              height="120rpx"
              shape="round"
              lazy-load
            />
            <view class="single-goods__num">x{{item.num}}</view>
          </view>
          <view class="single-goods__info">
            <view class="single-goods__title">{{item.title}}</view>
            <view wx:if="{{item.specsText}}" class="single-goods__specs">{{item.specsText}}</view>
            <view class="single-goods__meta">
              <price fill class="single-goods__price" price="{{item.price + ''}}" decimalSmaller />
            </view>
          </view>
        </view>
      </view>
      <view class="pay-detail">
        <view class="pay-item">
          <text>商品总额</text>
          <price fill decimalSmaller wr-class="pay-item__right font-bold" price="{{order.totalAmount || '0'}}" />
        </view>
        <view class="pay-item">
          <text>运费</text>
          <view class="pay-item__right font-bold">
            <block wx:if="{{order.freightFee}}">
              +
              <price fill decimalSmaller price="{{order.freightFee}}" />
            </block>
            <text wx:else>免运费</text>
          </view>
        </view>
        <view class="pay-item">
          <text>活动优惠</text>
          <view class="pay-item__right primary font-bold">
            -
            <price fill price="{{order.discountAmount || 0}}" />
          </view>
        </view>
        <view class="pay-item">
          <text>优惠券</text>
          <view class="pay-item__right" catchtap="onOpenCoupons">
            <block wx:if="{{order.couponAmount}}">
              -
              <price fill decimalSmaller price="{{order.couponAmount}}" />
            </block>
            <text wx:else>无可用</text>
            <!-- <t-icon name="chevron-right" size="32rpx" color="#BBBBBB" /> -->
          </view>
        </view>
        <view class="pay-item">
          <text>{{isPaid ? '实付' : '应付'}}</text>
          <price
            fill
            decimalSmaller
            wr-class="pay-item__right font-bold primary max-size"
            price="{{order.paymentAmount || '0'}}"
          />
        </view>
      </view>
    </order-card>
    <view class="pay-detail padding-inline">
      <view class="pay-item">
        <text>订单编号</text>
        <view class="pay-item__right" bindtap="onOrderNumCopy">
          <text class="order-no">{{order.orderNo}}</text>
          <view class="pay-item__right__copy">复制</view>
        </view>
      </view>
      <view class="pay-item">
        <text>下单时间</text>
        <view class="pay-item__right">
          <text class="order-no normal-color">{{formatCreateTime}}</text>
        </view>
      </view>
      <view class="border-bottom border-bottom-margin" />
      <view class="pay-item">
        <text>发票</text>
        <view class="pay-item__right" bindtap="onOrderInvoiceView">
          <text class="order-no normal-color">{{invoiceType}}</text>
          <view class="pay-item__right__copy">查看</view>
        </view>
      </view>
      <view class="pay-item">
        <text>备注</text>
        <view class="pay-item__right">
          <text class="order-no normal-color">{{order.remark || '-'}}</text>
        </view>
      </view>
      <view class="border-bottom border-bottom-margin" />
      <view class="pay-service" wx:if="{{storeDetail && storeDetail.storeTel}}" catch:tap="clickService">
        <t-icon name="service" size="40rpx" />
        <text decode="{{true}}">&nbsp;联系客服</text>
      </view>
    </view>
  </view>
  <view wx:if="{{_order.buttons.length > 0}}" class="bottom-bar">
    <order-button-bar order="{{_order}}" bindrefresh="onRefresh" isBtnMax />
  </view>
</t-pull-down-refresh>
<t-popup
  visible="{{showStatusPopup}}"
  placement="bottom"
  bind:visible-change="onStatusPopupVisibleChange"
>
  <view class="status-popup">
    <view class="status-popup__header">
      <text class="status-popup__title">订单状态</text>
      <t-icon name="close" size="40rpx" color="#999999" bindtap="onCloseStatusPopup" />
    </view>
    <view class="status-popup__body">
      <view class="status-node" wx:for="{{orderStatusLogs}}" wx:key="index">
        <view class="status-node__side">
          <view class="status-node__dot {{item.current ? 'status-node__dot--current' : ''}}"></view>
          <view class="status-node__line"></view>
        </view>
        <view class="status-node__content">
          <view class="status-node__desc {{item.current ? 'status-node__desc--current' : ''}}">{{item.desc}}</view>
          <view class="status-node__time">{{item.time || '进行中'}}</view>
        </view>
      </view>
    </view>
  </view>
</t-popup>
<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
