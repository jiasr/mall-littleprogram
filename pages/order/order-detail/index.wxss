:host {
  background-color: #f8f8f8;
}

.order-detail {
  width: 100%;
  box-sizing: border-box;
  padding: 0rpx 0rpx calc(env(safe-area-inset-bottom) + 144rpx);
}

.order-detail .header {
  width: auto;
  background-color: #ffffff;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
}

/* 配送地址独立卡片 */
.address-block {
  margin: 24rpx 24rpx 0;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

/* 顶部订单状态入口 */
.order-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background-color: #ffffff;
}
.order-status-bar__left {
  display: flex;
  flex-direction: column;
}
.order-status-bar__label {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
}

/* 底部状态流转弹层 */
.status-popup {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
}
.status-popup__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.status-popup__title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #333333;
}
.status-node {
  display: flex;
}
.status-node__side {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.status-node__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #cccccc;
  margin-top: 12rpx;
  flex-shrink: 0;
}
.status-node__dot--current {
  background-color: #fa4126;
}
.status-node__line {
  flex: 1;
  width: 2rpx;
  background-color: #e5e5e5;
  margin: 8rpx 0;
}
.status-node:last-child .status-node__line {
  background-color: transparent;
}
.status-node__content {
  flex: 1;
  padding-bottom: 40rpx;
}
.status-node:last-child .status-node__content {
  padding-bottom: 8rpx;
}
.status-node__desc {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
}
.status-node__desc--current {
  color: #fa4126;
  font-weight: 600;
}
.status-node__time {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #999999;
}
.order-detail .order-detail__header .desc .count-down {
  display: inline;
}
.order-detail .order-logistics {
  box-sizing: border-box;
  padding: 32rpx;
  width: 100%;
  background-color: #ffffff;
  overflow: hidden;
  color: #333333;
  font-size: 32rpx;
  line-height: 48rpx;
  display: flex;
  position: relative;
}

.order-logistics .logistics-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.order-logistics .logistics-content {
  flex: 1;
}

.order-logistics .logistics-content .logistics-time {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #999999;
  margin-top: 12rpx;
}

.order-logistics .logistics-back {
  color: #999999;
  align-self: center;
}

.order-logistics .edit-text {
  color: #fa4126;
  font-size: 26rpx;
  line-height: 36rpx;
}

.order-detail .border-bottom {
  margin: 0 auto;
  width: 100%;
  scale: 1 0.5;
  height: 2rpx;
  background-color: #e5e5e5;
}

.order-detail .border-bottom-margin {
  margin: 16rpx auto;
}

.order-detail .pay-detail {
  background-color: #ffffff;
  width: 100%;
  box-sizing: border-box;
}

.order-detail .padding-inline {
  padding: 16rpx 32rpx;
}

/* 商品区卡片：对齐头部圆角卡片风格 */
.goods-card-block {
  margin: 24rpx 24rpx 0 !important;
  border-radius: 24rpx !important;
  overflow: hidden;
}

/* 订单信息区独立卡片 */
.order-detail .pay-detail.padding-inline {
  margin: 24rpx 24rpx 0;
  width: auto;
  border-radius: 24rpx;
  overflow: hidden;
}

.order-detail .pay-detail .pay-item {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #666666;
  background-color: #ffffff;
}
.order-detail .pay-detail .pay-item .pay-item__right {
  color: #333333;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 400rpx;
}
.order-detail .pay-detail .pay-item .pay-item__right .pay-remark {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  max-width: 400rpx;
  text-overflow: ellipsis;
  overflow: hidden;
}
.order-detail .pay-detail .pay-item .font-bold {
  font-weight: bold;
}
.order-detail .pay-detail .pay-item .primary {
  color: #fa4126;
}
.order-detail .pay-detail .pay-item .max-size {
  font-size: 36rpx;
  line-height: 48rpx;
}

.pay-item .pay-item__right .pay-item__right__copy {
  width: 80rpx;
  height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #333333;
  position: relative;
}

.pay-item .pay-item__right .pay-item__right__copy::before {
  position: absolute;
  content: '';
  width: 200%;
  height: 200%;
  border-radius: 40rpx;
  border: 2rpx solid #dddddd;
  transform: scale(0.5);
  left: 0;
  top: 0;
  transform-origin: left top;
}

.pay-item .pay-item__right .order-no {
  color: #333333;
  font-size: 26rpx;
  line-height: 40rpx;
  padding-right: 16rpx;
}

.pay-item .pay-item__right .normal-color {
  color: #333333;
}

.order-detail .pay-detail .pay-service {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 36rpx;
  color: #333333;
  background-color: #ffffff;
}

.bottom-bar {
  position: fixed;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: 10;
  background: #fff;
  height: 112rpx;
  width: 686rpx;
  padding: 0rpx 32rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
}

.bottom-bar::before {
  position: absolute;
  content: '';
  width: 200%;
  height: 200%;
  border-top: 2rpx solid #dddddd;
  transform: scale(0.5);
  left: 0;
  top: 0;
  transform-origin: left top;
}

.goods-button-bar {
  height: 112rpx;
  width: 686rpx;
  margin-bottom: 16rpx;
}

.t-class-indicator {
  color: #b9b9b9 !important;
}

.add-notes__confirm {
  color: #fa4126 !important;
}

.t-button {
  --td-button-default-color: #000;
  --td-button-primary-text-color: #fa4126;
}

/* 商品区：单件图左文右 / 多件缩略图+名称 */
.goods-block {
  padding: 16rpx 32rpx;
}
.single-goods {
  display: flex;
  align-items: flex-start;
}
.single-goods__img-wrap {
  position: relative;
  flex-shrink: 0;
}
.single-goods__img {
  width: 120rpx !important;
  height: 120rpx !important;
  display: block;
}
.single-goods__info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.single-goods__title {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.single-goods__specs {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.single-goods__meta {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
}
.single-goods__price {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #fa4126;
  font-weight: bold;
}
.single-goods__num {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 0 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.5);
  border-top-left-radius: 8rpx;
}
.goods-block .single-goods + .single-goods {
  border-top: 2rpx solid #f2f2f2;
  padding-top: 24rpx;
  margin-top: 24rpx;
}
