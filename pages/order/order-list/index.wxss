:host {
  background-color: #f5f5f5;
}
.page-container .tab-bar__placeholder,
.page-container .tab-bar__inner {
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
}
.page-container .tab-bar__inner {
  font-size: 26rpx;
  color: #333333;
  position: fixed;
  width: 100vw;
  top: 0;
  left: 0;
  z-index: 100;
}
.page-container .tab-bar__inner.order-nav .order-nav-item .bottom-line {
  bottom: 12rpx;
}
.tab-bar__inner .t-tabs-is-active {
  color: #fa4126 !important;
}

.tab-bar__inner .t-tabs-track {
  background: #fa4126 !important;
}

.page-container .tab-bar__active {
  font-size: 28rpx;
}
.page-container .specs-popup .bottom-btn {
  color: #fa4126;
  color: var(--color-primary, #fa4126);
}
.page-container .specs-popup .bottom-btn::after {
  border-color: #fa4126;
  border-color: var(--color-primary, #fa4126);
}
.dialog .dialog__button-confirm {
  color: #fa4126;
  color: var(--color-primary, #fa4126);
}
.list-loading {
  height: 100rpx;
}
.empty-wrapper {
  height: calc(100vh - 88rpx);
}
.btn-bar {
  margin-top: 20rpx;
}
.load-more {
  margin: 0 24rpx;
}
wr-order-goods-card:not(:first-child) .wr-goods-card {
  margin-top: 40rpx;
}

.price-total {
  font-size: 24rpx;
  line-height: 32rpx;
  color: #999999;
  padding-top: 10rpx;
  width: 100%;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.price-total .goods-count {
  font-size: 24rpx;
  color: #999999;
}
.price-total .real-pay-wrap {
  display: flex;
  align-items: baseline;
}
.price-total .real-pay-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 6rpx;
}
.price-total .real-pay {
  font-size: 36rpx;
  line-height: 48rpx;
  color: #fa4126;
  font-weight: bold;
}

.t-tabs.t-tabs--top .t-tabs-scroll {
  border: none !important;
}
.t-empty-text {
  font-size: 28rpx;
  color: #999;
}

.page-container .order-time {
  color: #666666;
  font-size: 22rpx;
  line-height: 40rpx;
}
.t-class-indicator {
  color: #b9b9b9 !important;
}
.tab-bar .tab-bar__active {
  color: #333333 !important;
}

.tab-bar .t-tabs-track {
  background: #333333 !important;
}

.t-button {
  --td-button-default-color: #000;
  --td-button-primary-text-color: #fa4126;
}

/* 单件商品：左侧图 + 右侧标题/规格/数量 */
.single-goods {
  display: flex;
  align-items: flex-start;
}
.single-goods__img-wrap {
  position: relative;
  flex-shrink: 0;
}
.single-goods__img {
  width: 120rpx !important;
  height: 120rpx !important;
  display: block;
}
.single-goods__info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.single-goods__title {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.single-goods__specs {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.single-goods__meta {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
}
.single-goods__price {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #fa4126;
  font-weight: bold;
}
.single-goods__num {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999999;
}
/* 订单商品缩略图：横向排列，图下带名称 */
.sku-thumb-list {
  display: flex;
  flex-wrap: wrap;
}
.sku-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 88rpx;
  margin: 8rpx 12rpx 8rpx 0;
  flex-shrink: 0;
}
.sku-thumb__img-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
}
.sku-thumb__img {
  width: 80rpx !important;
  height: 80rpx !important;
  display: block;
}
.sku-thumb__num {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 0 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.5);
  border-top-left-radius: 8rpx;
}
.sku-thumb__name {
  margin-top: 4rpx;
  width: 100%;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #999999;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
