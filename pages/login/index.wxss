page {
  background-color: #f5f5f5;
}

.login-page {
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.login-header {
  margin-top: 140rpx;
  text-align: center;
  margin-bottom: 100rpx;
}

.login-logo {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  background: #ff5f15;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 协议勾选 */
.login-agreement {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
}

.checkbox-wrap {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.checkbox--checked {
  background: #ff5f15;
  border-color: #ff5f15;
}

.checkbox__tick {
  width: 16rpx;
  height: 8rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}

.agreement-text {
  font-size: 26rpx;
  color: #666;
}

.agreement-link {
  color: #ff5f15;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 0;
  box-sizing: border-box;
}

.login-btn--active {
  background: #ff5f15;
  color: #fff;
}

.login-btn--disabled {
  background: #e0e0e0;
  color: #aaa;
}

.login-btn--complete {
  margin-top: 48rpx;
}

.login-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

/* 头像 + 昵称 一体卡片 */
.profile-card {
  margin-top: 48rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

/* 头像：整块可点选 */
.profile-card__avatar {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  padding: 0;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.profile-card__avatar::after {
  border: none;
}

.profile-card__avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.profile-card__avatar-ph {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.profile-card__avatar-ph-icon {
  font-size: 44rpx;
  color: #c0c4cc;
  line-height: 1;
}

.profile-card__avatar-ph-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 分隔线 */
.profile-card__divider {
  width: 2rpx;
  height: 88rpx;
  background: #f0f0f0;
  margin: 0 32rpx;
  flex-shrink: 0;
}

/* 昵称 */
.profile-card__nickname {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.profile-card__nickname-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.profile-card__nickname-input {
  font-size: 30rpx;
  color: #333;
  height: 48rpx;
  line-height: 48rpx;
}

.profile-card__nickname-ph {
  color: #c0c4cc;
}
