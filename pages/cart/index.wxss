:host {
  padding-bottom: 100rpx;
}

.gap {
  height: 100rpx;
  width: 100%;
}

.t-button {
  --td-button-default-color: #000;
  --td-button-primary-text-color: #fa4126;
}

/* 全覆盖登录引导弹窗 */
.login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 56rpx 40rpx 0;
  box-sizing: border-box;
}

.login-dialog__title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.login-dialog__content {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 44rpx;
  margin-bottom: 48rpx;
}

.login-dialog__btns {
  display: flex;
  border-top: 1rpx solid #eee;
}

.login-dialog__btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
}

.login-dialog__btn--cancel {
  color: #999;
  border-right: 1rpx solid #eee;
}

.login-dialog__btn--confirm {
  color: #ff5f15;
  font-weight: bold;
}
